{
  // Cloudflare Pages Functions run on Workers, not in the browser, so they're type-checked separately with the Workers types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [ "esnext" ],
    "types": [ "@cloudflare/workers-types" ],
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [ "." ]
}
