{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tabler/icons-react": "^3.36.1",
    "baseline-browser-mapping": "^2.10.0",
    "bootstrap": "^5.3.8",
    "caniuse-lite": "^1.0.30001770",
    "jszip": "^3.10.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.3",
    "react-ga4": "^2.1.0",
    "react-resizable-panels": "^4.4.1",
    "react-router-dom": "^7.12.0",
    "stats.js": "^0.17.0",
    "three": "^0.182.0",
    "typescript": "^5.9.3",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "start": "vite",
    "start:zip": "vite --mode zip",
    "build": "tsc && vite build",
    "build:standalone": "tsc && vite build --config vite.config.standalone.ts",
    "preview": "vite preview",
    "test": "jest",
    "create-zips": "tsx scripts/create-icon-zips.ts",
    "create-zips:deploy": "tsx scripts/create-icon-zips.ts --source dist/icons --delete-originals",
    "predeploy": "npm run create-zips:deploy && npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.7",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.0",
    "jest": "^30.2.0",
    "jest-expect-message": "^1.1.3",
    "jest-junit": "^16.0.0",
    "sass": "^1.97.2",
    "source-map": "^0.7.6",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-tsconfig-paths": "^6.0.4"
  }
}
