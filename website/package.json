{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "baseline-browser-mapping": "^2.11.28",
    "bootstrap": "^5.3.8",
    "caniuse-lite": "^1.0.30001815",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-ga4": "^3.0.1",
    "react-resizable-panels": "^4.14.4",
    "react-router-dom": "^7.18.4",
    "stats.js": "^0.17.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "start:zip": "vite --mode zip",
    "build": "tsc && vite build",
    "build:standalone": "tsc && vite build --config vite.config.standalone.ts",
    "preview": "vite preview",
    "test": "jest",
    "create-zips": "tsx scripts/create-icon-zips.ts",
    "create-zips:deploy": "tsx scripts/create-icon-zips.ts --delete-originals",
    "predeploy": "npm run create-zips:deploy && npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.6",
    "jest": "^30.5.2",
    "jest-expect-message": "^1.1.3",
    "jest-junit": "^17.0.0",
    "sass": "^1.105.1",
    "source-map": "^0.8.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
