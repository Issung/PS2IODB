{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "baseline-browser-mapping": "^2.10.29",
    "bootstrap": "^5.3.8",
    "caniuse-lite": "^1.0.30001792",
    "jszip": "^3.10.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-ga4": "^3.0.1",
    "react-resizable-panels": "^4.11.1",
    "react-router-dom": "^7.15.1",
    "stats.js": "^0.17.0",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "web-vitals": "^5.2.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "start:zip": "vite --mode zip",
    "build": "tsc && vite build",
    "build:standalone": "tsc && vite build --config vite.config.standalone.ts",
    "preview": "vite preview",
    "test": "jest",
    "create-zips": "tsx scripts/create-icon-zips.ts",
    "create-zips:deploy": "tsx scripts/create-icon-zips.ts --delete-originals",
    "predeploy": "npm run create-zips:deploy && npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "jest-expect-message": "^1.1.3",
    "jest-junit": "^17.0.0",
    "sass": "^1.99.0",
    "source-map": "^0.7.6",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.0",
    "vite": "^8.0.13",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
