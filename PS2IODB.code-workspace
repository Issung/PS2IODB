{
	"folders": [
		{
			"path": ".",
			"name": "Root",
		},
		{
			"name": "Extractor",
			"path": "./extractor"
		},
		{
			"name": "Website",
			"path": "./website"
		},
	],
	"settings": {
		// https://github.com/microsoft/vscode/issues/82145#issuecomment-829347865
		"files.exclude": {
			"website": true,
			"extractor": true,
		},
		"search.exclude": {
			"**/dist": true,
			"**/node_modules": true,
		},
		"jest.rootPath": "./website/src",
		"jest.disabledWorkspaceFolders": [
			"Root",
			"Extractor"
		],
		"liveServer.settings.multiRootWorkspaceName": "Website",
		"jest.runMode": "on-demand",
		"terminal.integrated.defaultProfile.windows": "PowerShell"
	},
	"extensions": {
		"recommendations": [
			// TypeScript 7 no longer ships tsserver.js, so VS Code's built-in TS support can't use the workspace version.
			// This extension provides the TS 7 native language server instead.
			"TypeScriptTeam.native-preview"
		]
	}
}